TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB=mafia_bot

# Production: public HTTPS origin Telegram should POST updates to.
# Local `go run` without this uses long polling.
# WEBHOOK_URL=https://mafia-bot.onrender.com
# WEBHOOK_SECRET=a-long-random-string
# PORT=8080

# Local dev only — Render sets env vars in the dashboard (see docs/DEPLOY_RENDER.md)
# RENDER=true
